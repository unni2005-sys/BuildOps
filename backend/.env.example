# Buildathon Management System Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-buildathon-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Leave empty to use local SQLite during local testing/evaluation
DATABASE_URL=
SUPABASE_DB_URL=

# Or individual DB credentials:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# UPI Payment Details
UPI_ID=unniacc9961@okaxis
UPI_PAYEE_NAME=Build Ops ASIET
UPI_PHONE_NUMBER=9497290648

# Frontend URL
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Event Details
EVENT_NAME=Build Ops
EVENT_DATE=December 8th, 5:00 PM – December 9th, 8:00 AM, 2026
EVENT_VENUE=Innovation & Technology Hub, Campus Main Hall
REGISTRATION_FEE_INR=500
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite-code

# Email Configuration (SMTP)
# If left blank, Django uses Console Email Backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Build Ops Team <noreply@buildops.org>
