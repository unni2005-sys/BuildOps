# Buildathon Management System Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-buildathon-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Leave empty to use local SQLite during local testing/evaluation
DATABASE_URL=
SUPABASE_DB_URL=

# Or individual DB credentials:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Cashfree Payment Gateway Credentials
# Get credentials from Cashfree Merchant Dashboard (Sandbox / Production)
CASHFREE_APP_ID=test_app_id
CASHFREE_SECRET_KEY=test_secret_key
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
# Cashfree Webhook Secret for signature verification
CASHFREE_WEBHOOK_SECRET=test_webhook_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Event Details
EVENT_NAME=National Buildathon 2026
EVENT_DATE=November 28-29, 2026
EVENT_VENUE=Innovation & Technology Hub, Campus Main Hall
REGISTRATION_FEE_INR=499

# Email Configuration (SMTP)
# If left blank, Django uses Console Email Backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Buildathon Team <noreply@buildathon.org>
